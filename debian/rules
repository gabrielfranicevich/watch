#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --locked --release --bin watch

override_dh_auto_test:
	cargo test --locked --all-targets

override_dh_auto_install:
	install -D -m 0755 target/release/watch debian/tmp/usr/bin/watch-anime
	install -D -m 0644 watch.1 debian/tmp/usr/share/man/man1/watch-anime.1
